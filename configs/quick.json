      "dist_shift",
      "outlier_inject",
      "feat_dropout"
    ],
    "attacks_reg": [
      "target_shift",
      "leverage_attack",
      "target_flip_extreme",
      "feat_perturb",
      "badnets",
      "repr_inversion",
      "dist_shift",
      "feat_dropout",
      "outlier_inject",
      "gauss_noise"
    ],
    "rates": [
      0.01,
      0.05,
      0.1,
      0.2
    ],
    "seeds": 1,
    "epochs": 30,
    "batch_size": 512,
    "lr": 0.001,
    "seed": 0,
    "context": true,
    "scorer": "trees"
