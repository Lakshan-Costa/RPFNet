      "label_flip",
      "clean_label",
      "badnets",
      "feat_perturb",
      "dist_shift"
    ],
    "attacks_reg": [
      "target_shift",
      "leverage_attack",
      "feat_perturb",
      "dist_shift"
    ],
    "unseen_attacks": [
      "influence_lr",
      "subpopulation",
