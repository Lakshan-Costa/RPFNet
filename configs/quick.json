    "rates": [
      0.005,
      0.01,
      0.05,
      0.1
    ],
    "seeds": 2,
    "baselines": [
      "IsoForest",
      "ECOD",
      "kNNLabel",
      "ConfidentLearning",
      "SEVER",
      "TRIM",
      "iTRIM",
      "ECOD+CL"
    ],
    "signal_baselines": true,
    "minp": true,
    "stack": true,
    "fdr_q": 0.1,
    "downstream": false
  },
  "adaptive": {
    "lams": [
      0,
      1,
      5
    ],
    "iters": 15,
    "base": "label_flip",
    "rate": 0.1,
    "seeds": 1,
    "max_n": 2000,
    "baselines": [
